+static void ShowGamepadControls(void)
+{
+    word x = DrawTextFrame(SETTINGS_LEFT, SETTINGS_TOP, SETTINGS_HEIGHT, SETTINGS_WIDTH,
+                           "Gamepad Controls", "Esc or LB to go back", true);
+
+    DrawTextLine(x + 1, 7,  "D-pad, Left stick  Move");
+    DrawTextLine(x + 1, 8,  "A                  Jump or select");
+    DrawTextLine(x + 1, 9,  "B                  Drop bomb");
+    DrawTextLine(x + 1, 10, "Start              Pause menu");
+    DrawTextLine(x + 1, 11, "LB                 Back");
+    while (WaitSpinner(x + 30, 14) != SCANCODE_ESC) {}
+}
+
+static void DrawGameSettings(word x, byte selection, bbool save_failed)
+{
+    static const byte rows[SETTING_COUNT] = {7, 8, 10, 11, 12};
+    char value[20];
+
+    char *help = selection <= SETTING_GAMEPAD ? "Enter or A opens, Esc or LB back"
+                                                     : "Left and Right   Esc or LB back";
+    DrawTextFrame(SETTINGS_LEFT, SETTINGS_TOP, SETTINGS_HEIGHT, SETTINGS_WIDTH,
+                  "Game Settings", save_failed ? "Could not save filter" : help, true);
+    DrawTextLine(x + 2, rows[SETTING_KEYBOARD], "Keyboard Mapping");
+    DrawTextLine(x + 2, rows[SETTING_GAMEPAD], "Gamepad Controls");
+    DrawTextLine(x + 2, rows[SETTING_MUSIC], "Music Volume");
+    DrawTextLine(x + 2, rows[SETTING_SOUND], "Sound Volume");
+    DrawTextLine(x + 2, rows[SETTING_FILTER], "Filter");
+
+    snprintf(value, sizeof value, "< %3u%% >", (unsigned)musicVolume);
+    DrawTextLine(x + 25, rows[SETTING_MUSIC], value);
+    snprintf(value, sizeof value, "< %3u%% >", (unsigned)soundVolume);
+    DrawTextLine(x + 25, rows[SETTING_SOUND], value);
+    snprintf(value, sizeof value, "< %s >", PlatformDisplayFilterName());
+    DrawTextLine(x + 33 - strlen(value), rows[SETTING_FILTER], value);
+    DrawTextLine(x, rows[selection], ">");
+}

+static void DrawPreviewSpawner(word index, Spawner *sp, word y, word mode)
+{
+    /* Health power-ups use the same rising motion as other pickups. */
+    if (sp->actor == ACT_HAMBURGER) {
+        DrawSprite(sp->actor, 0, sp->x, y, mode);
+        return;
+    }
+    DrawSmoothEffect((previewSpawnerIdentity[index] << 16) | (0x2000u | index),
+                     sp->actor, 0, sp->x, y, mode);
+}

+/* A sprite can straddle the top of the map or fall below its final row.
+ * Those cells are air, with no tile data to read. */
+static word SpriteMoveTile(int x, int y)
+{
+    if (x < 0 || x >= mapWidth || y < 0 || y >= maxScrollY + SCROLLH + 1)
+        return TILE_EMPTY;
+    unsigned index = (unsigned)y * mapWidth + (unsigned)x;
+    if (index >= WORD_MAX / sizeof(word)) return TILE_EMPTY;
+    word tile = mapData.w[index];
+    return tile / 8 < 7000 ? tile : TILE_EMPTY;
+}

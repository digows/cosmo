+#ifdef COSMO_WIDESCREEN
+static bool WideWorldEnabled(void)
+{
+    return demoState == DEMO_STATE_NONE && WideTerrainColumns() && mapWidth >= SCROLLW + WideTerrainColumns();
+}
+#endif
+
+static int CameraRightLimit(void)
+{
+    int limit = mapWidth - SCROLLW;
+#ifdef COSMO_WIDESCREEN
+    if (WideWorldEnabled()) limit -= WideTerrainColumns();
+    if (WideTerrainColumns() && demoState == DEMO_STATE_NONE && limit < 0) limit = 0;
+#endif
+    return limit;
+}

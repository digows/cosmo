 table at the end whether the prompt was displayed or not.
 */
+#ifdef __ANDROID__
+void PlatformSetNameInput(int enabled);
+int PlatformReadNameInput(void);
+
+static void ReadHighScoreName(word x, word y, char *dest, word max_length)
+{
+    word length = 0;
+    PlatformSetNameInput(1);
+    for (;;) {
+        StepWaitSpinner(x + length + 1, y);
+        int character = PlatformReadNameInput();
+        if (character == '\r' || character == 0x1b) {
+            EraseWaitSpinner(x + length + 1, y);
+            dest[character == 0x1b ? 0 : length] = '\0';
+            PlatformSetNameInput(0);
+            return;
+        }
+        if (character == '\b') {
+            EraseWaitSpinner(x + length + 1, y);
+            if (length) EraseWaitSpinner(x + length--, y);
+        } else if (character && length < max_length) {
+            char glyph[] = {(char)character, '\0'};
+            dest[length++] = (char)character;
+            DrawTextLine(x + length, y, glyph);
+        }
+        WaitHard(1);
+    }
+}
+#endif

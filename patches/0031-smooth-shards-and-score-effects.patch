 Handle one frame of score effect movement.
 */
+int BeginPreviewEffect(dword identity, int x, int y, word mode, int expand);
+void DrawPreviewEffectTile(const byte *pixels, word x, word y, word mode);
+
+static void DrawSmoothEffect(dword identity, word sprite, word frame,
+                             word x, word y, word mode)
+{
+    if (demoState != DEMO_STATE_NONE ||
+        !BeginPreviewEffect(identity, (int)x - scrollX, (int)y - scrollY, mode, sprite == SPR_EXPLOSION)) {
+        DrawSprite(sprite, frame, x, y, mode);
+        return;
+    }
+
+    word offset = actorInfoData[sprite] + frame * 4;
+    word height = actorInfoData[offset];
+    word width = actorInfoData[offset + 1];
+    const byte *src = actorTileData[actorInfoData[offset + 3]] + actorInfoData[offset + 2];
+    for (word row = 0; row < height; ++row) {
+        int sy = mode == DRAW_MODE_FLIPPED
+            ? (int)y - row - scrollY + 1
+            : (int)y - height + row - scrollY + 2;
+        for (word col = 0; col < width; ++col) {
+            int sx = (int)x + col - scrollX + 1;
+            if (sx > 0 && sx <= WorldDrawRight() - scrollX && sy > 0 && sy <= SCROLLH)
+                DrawPreviewEffectTile(src, sx, sy, mode);
+            src += 40;
+        }
+    }
+}

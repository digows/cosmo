+/* Move the marker without unfolding and redrawing the whole menu. */
+void MoveMainMenuCursor(byte previous_option, byte selected_option)
+{
+#ifdef FOREIGN_ORDERS
+    static const byte menu_rows[] = {
+        5, 6, 7, 8, 9, 10, 12, 14, 15, 16, 17, 18, 20
+    };
+#else
+    static const byte menu_rows[] = {
+        5, 6, 7, 8, 9, 10, 12, 14, 15, 16, 17, 19
+    };
+#endif
+    word x = 11;
+
+    if (previous_option >= sizeof menu_rows / sizeof menu_rows[0] ||
+        selected_option >= sizeof menu_rows / sizeof menu_rows[0]) return;
+    EGA_MODE_LATCHED_WRITE();
+    DRAW_SOLID_TILE_XY(TILE_DARK_GRAY, x, menu_rows[previous_option]);
+    DrawTextLine(x, menu_rows[selected_option], ">");
+}

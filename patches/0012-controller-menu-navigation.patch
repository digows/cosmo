+static byte MainMenuOptionKey(byte option)
+{
+#ifdef FOREIGN_ORDERS
+    static const byte options[] = {
+        SCANCODE_B, SCANCODE_R, SCANCODE_S, SCANCODE_I, SCANCODE_H,
+        SCANCODE_G, SCANCODE_O, SCANCODE_F, SCANCODE_A, SCANCODE_D,
+        SCANCODE_C, SCANCODE_T, SCANCODE_Q
+    };
+#else
+    static const byte options[] = {
+        SCANCODE_B, SCANCODE_R, SCANCODE_S, SCANCODE_I, SCANCODE_H,
+        SCANCODE_G, SCANCODE_O, SCANCODE_A, SCANCODE_D, SCANCODE_C,
+        SCANCODE_T, SCANCODE_Q
+    };
+#endif
+    return option < sizeof options / sizeof options[0] ? options[option] : SCANCODE_B;
+}

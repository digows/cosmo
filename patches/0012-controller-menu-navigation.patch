+/*
+Choose a save slot with the keyboard or controller. Space/Enter confirms the
+highlighted slot; Escape or the controller's bomb button cancels.
+*/
+static byte PromptGameSlot(word x, word y)
+{
+    byte slot = 1;
+    byte scancode;
+    byte display_index;
+    char slot_display[6] = "  1  ";
+
+    for (;;) {
+        slot_display[0] = slot > 1 ? '<' : ' ';
+        slot_display[2] = (char)('0' + slot);
+        slot_display[4] = slot < 9 ? '>' : ' ';
+        EGA_MODE_LATCHED_WRITE();
+        for (display_index = 0; display_index < 5; ++display_index)
+            DrawSolidTile(TILE_DARK_GRAY, 18 + display_index + ((y + 1) * 320));
+        DrawTextLine(18, y + 1, slot_display);
+        scancode = WaitSpinner(x, y);
+
+        if (scancode == scancodeNorth || scancode == SCANCODE_KP_8 ||
+            scancode == scancodeEast || scancode == SCANCODE_KP_6) {
+            if (slot < 9) ++slot;
+        } else if (scancode == scancodeSouth || scancode == SCANCODE_KP_2 ||
+                   scancode == scancodeWest || scancode == SCANCODE_KP_4) {
+            if (slot > 1) --slot;
+        } else if (scancode == SCANCODE_SPACE || scancode == SCANCODE_ENTER) {
+            return SCANCODE_1 + slot - 1;
+        } else if (scancode == SCANCODE_ESC || scancode == scancodeBomb) {
+            return SCANCODE_ESC;
+        } else {
+            return scancode;
+        }
+    }
+}

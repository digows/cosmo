+/* Rendering can look ahead without extending the actor activation area. */
+static word WorldDrawRight(void)
+{
+    word right = scrollX + SCROLLW;
+#ifdef COSMO_WIDESCREEN
+    if (demoState == DEMO_STATE_NONE) {
+        right += WideTerrainColumns();
+        if (right > mapWidth) right = mapWidth;
+    }
+#endif
+    return right;
+}
+
+#ifdef COSMO_WIDESCREEN
+static bool SpriteInWideStrip(word sprite, word frame, word x, word y)
+{
+    if (x < scrollX + SCROLLW || x >= WorldDrawRight()) return false;
+    word offset = actorInfoData[sprite] + frame * 4;
+    word height = actorInfoData[offset];
+    return y >= scrollY && (int)y - height + 1 < scrollY + SCROLLH;
+}
+#endif
